
debug = false

[grpc_server]
host = "0.0.0.0"
port = 50051

[postgres]
host = "localhost"
port = 5433
username = "postgres"
password = "postgres"
database = "profile_service"
should_log_sql = false
pool_size = 10
pool_max_overflow = 20

[rabbitmq]
host = "localhost"
port = 5672
username = "guest"
password = "guest"
vhost = "/"

[minio]
endpoint = "localhost:9000"
access_key = "minioadmin"
secret_key = "minioadmin"
bucket = "profiles"
secure = false
presigned_ttl_seconds = 900

[geocoding]
enabled = false
base_url = "https://geocode.maps.co"
api_key = ""
timeout_seconds = 5.0
cache_ttl_seconds = 2592000
cache_max_entries = 50000
